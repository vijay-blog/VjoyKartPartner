<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/nxm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/customersBackButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Customers" android:textSize="24sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/customersRefreshButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_popup_sync" android:contentDescription="Refresh"/>
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/customersSearchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search name, phone or email" android:singleLine="true"/>
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <com.google.android.material.chip.Chip android:id="@+id/customerStatusAllChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All"/>
        <com.google.android.material.chip.Chip android:id="@+id/customerStatusActiveChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active" android:layout_marginStart="4dp"/>
        <com.google.android.material.chip.Chip android:id="@+id/customerStatusInactiveChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inactive" android:layout_marginStart="4dp"/>
        <com.google.android.material.chip.Chip android:id="@+id/customerStatusSuspendedChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suspended" android:layout_marginStart="4dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/customersClearButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:layout_marginStart="4dp"/>
    </LinearLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/customersSwipeRefresh" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/customersRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <ProgressBar android:id="@+id/customersLoading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
            <LinearLayout android:id="@+id/customersStateSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:visibility="gone">
                <TextView android:id="@+id/customersStateTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/customersStateMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/customersRetryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Retry"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
