<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/availabilitySwipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_vjoy_premium_screen">
