<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/deliveryDashboardSwipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_vjoy_premium_screen">
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="32dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/vjoykart_icon" android:contentDescription="VJoyKart"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:id="@+id/greetingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Good morning" android:textColor="#AEB5C5" android:textSize="14sp"/>
<TextView android:id="@+id/partnerNameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delivery Partner" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/logoutButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logout" android:textColor="#A9BCFF"/>
</LinearLayout>

<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="0dp" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="@drawable/bg_vjoy_hero">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Partner workspace" android:textColor="#FFF7FC" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:id="@+id/availabilityText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_vjoy_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:text="ONLINE" android:textColor="#6FE3D2" android:textStyle="bold"/>
</LinearLayout>
<TextView android:id="@+id/dashboardMessageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Live delivery performance from VJoyKart." android:textColor="#C8CDDA" android:textSize="14sp"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Today at a glance" android:textColor="#FFF7FC" android:textSize="22sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/metricsSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Active" android:textColor="#B8BFCD" android:textSize="13sp"/>
<TextView android:id="@+id/activeOrdersValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Assigned" android:textColor="#B8BFCD" android:textSize="13sp"/>
<TextView android:id="@+id/assignedOrdersValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Picked up" android:textColor="#B8BFCD" android:textSize="13sp"/>
<TextView android:id="@+id/pickedUpOrdersValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Out for delivery" android:textColor="#B8BFCD" android:textSize="13sp"/>
<TextView android:id="@+id/outForDeliveryValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Completed" android:textColor="#B8BFCD" android:textSize="13sp"/>
<TextView android:id="@+id/completedTodayValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="92dp" android:layout_weight="1" android:layout_marginEnd="5dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="22dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="15dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Today's earnings" android:textColor="#B8BFCD" android:textSize="13sp"/>
<TextView android:id="@+id/todayEarningsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="0" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Quick actions" android:textColor="#FFF7FC" android:textSize="22sp" android:textStyle="bold"/>
<com.google.android.material.button.MaterialButton android:id="@+id/assignedOrdersButton" style="@style/VJoyPremiumButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Assigned Orders"/>
<com.google.android.material.button.MaterialButton android:id="@+id/availabilityButton" style="@style/VJoyPremiumOutlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Go Online / Availability"/>
<com.google.android.material.button.MaterialButton android:id="@+id/notificationsButton" style="@style/VJoyPremiumOutlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Notifications"/>
<com.google.android.material.button.MaterialButton android:id="@+id/historyButton" style="@style/VJoyPremiumOutlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Delivery History"/>
<com.google.android.material.button.MaterialButton android:id="@+id/earningsButton" style="@style/VJoyPremiumOutlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Earnings"/>
<com.google.android.material.button.MaterialButton android:id="@+id/profileButton" style="@style/VJoyPremiumOutlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="My Profile"/>

<com.google.android.material.card.MaterialCardView android:id="@+id/dashboardStateCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="#151A22" app:strokeColor="#33464E60" app:strokeWidth="1dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:id="@+id/stateTitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF7FC" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/stateDescriptionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#BFC5D1"/><com.google.android.material.button.MaterialButton android:id="@+id/retryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Retry"/></LinearLayout></com.google.android.material.card.MaterialCardView>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>