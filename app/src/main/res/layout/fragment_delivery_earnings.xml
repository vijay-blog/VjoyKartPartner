<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_vjoy_premium_screen">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/vjoykart_icon" android:contentDescription="VJoyKart"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Earnings" android:textColor="#FFF7FC" android:textSize="24sp" android:textStyle="bold"/></LinearLayout>
<TextView android:id="@+id/filterSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="All time" android:textColor="#AEB5C5"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><com.google.android.material.button.MaterialButton android:id="@+id/fromDateButton" style="@style/VJoyPremiumOutlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="From date"/><com.google.android.material.button.MaterialButton android:id="@+id/toDateButton" style="@style/VJoyPremiumOutlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="To date"/></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/clearDatesButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear dates"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Earnings summary" android:textColor="#FFF7FC" android:textSize="20sp" android:textStyle="bold"/><TextView android:id="@+id/totalValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Total earned: —" android:textColor="#6FE3D2" android:textSize="28sp" android:textStyle="bold"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"><TextView android:id="@+id/todayValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today
—" android:textColor="#D8DCE6" android:textSize="15sp"/><TextView android:id="@+id/weekValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="This week
—" android:textColor="#D8DCE6" android:textSize="15sp"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"><TextView android:id="@+id/monthValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="This month
—" android:textColor="#D8DCE6" android:textSize="15sp"/><TextView android:id="@+id/completedValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Completed
—" android:textColor="#D8DCE6" android:textSize="15sp"/></LinearLayout><TextView android:id="@+id/pendingValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Pending payout: —" android:textColor="#B8BFCD"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp"/><TextView android:id="@+id/stateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#BFC5D1"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="16dp"/><ProgressBar android:id="@+id/paginationProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone"/>
</LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>