<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_vjoy_premium_screen">
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/vjoykart_icon" android:contentDescription="VJoyKart"/><TextView android:id="@+id/orderId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:textColor="#FFF7FC" android:textSize="22sp" android:textStyle="bold"/><com.google.android.material.button.MaterialButton android:id="@+id/shareButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share"/></LinearLayout>
<ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"/>
<com.google.android.material.card.MaterialCardView android:id="@+id/stateCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="#151A22" app:strokeColor="#33464E60" app:strokeWidth="1dp" app:cardCornerRadius="22dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:id="@+id/stateTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF7FC" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/stateMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#BFC5D1"/><com.google.android.material.button.MaterialButton android:id="@+id/retryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Retry"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#202A46" app:strokeColor="#669DB8FF" app:strokeWidth="1dp" app:cardCornerRadius="26dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6FE3D2" android:textSize="18sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Delivery mission" android:textColor="#BFC5D1"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Follow the route, complete each step, and finish safely." android:textColor="#8F98A9" android:textSize="13sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Customer" android:textColor="#FFF7FC" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/customer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#D8DCE6" android:textSize="16sp"/><TextView android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:clickable="true" android:focusable="true" android:textColor="#9DB8FF"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Delivery address" android:textColor="#FFF7FC" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:textColor="#D8DCE6" android:textSize="15sp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"><com.google.android.material.button.MaterialButton android:id="@+id/mapButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Maps"/><com.google.android.material.button.MaterialButton android:id="@+id/navigateButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Navigate"/><com.google.android.material.button.MaterialButton android:id="@+id/copyAddressButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy"/></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Payment" android:textColor="#FFF7FC" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#D8DCE6"/><TextView android:id="@+id/payment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#BFC5D1"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/proofCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Proof of delivery" android:textColor="#FFF7FC" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/proofStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="#BFC5D1"/><com.google.android.material.button.MaterialButton android:id="@+id/viewProofButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View proof"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Items" android:textColor="#FFF7FC" android:textSize="20sp" android:textStyle="bold"/><LinearLayout android:id="@+id/items" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="vertical"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Timeline" android:textColor="#FFF7FC" android:textSize="20sp" android:textStyle="bold"/><LinearLayout android:id="@+id/timeline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="vertical"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Next action" android:textColor="#FFF7FC" android:textSize="20sp" android:textStyle="bold"/><LinearLayout android:id="@+id/actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
</LinearLayout>
</LinearLayout></androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>