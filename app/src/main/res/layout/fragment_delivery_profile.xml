<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_vjoy_premium_screen">
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/vjoykart_icon" android:contentDescription="VJoyKart"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partner profile" android:textColor="#FFF7FC" android:textSize="24sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your VJoyKart delivery identity" android:textColor="#AEB5C5"/></LinearLayout></LinearLayout>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="#202A46" app:strokeColor="#669DB8FF" app:strokeWidth="1dp" app:cardCornerRadius="26dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp"><TextView android:id="@+id/nameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#FFF7FC" android:textSize="25sp" android:textStyle="bold"/><TextView android:id="@+id/phoneText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#D1D6E2"/><TextView android:id="@+id/emailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#AEB5C5"/><TextView android:id="@+id/verificationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#6FE3D2" android:textStyle="bold"/><TextView android:id="@+id/accountText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#BFC5D1"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vehicle &amp; licence" android:textColor="#FFF7FC" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/vehicleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#D8DCE6"/><TextView android:id="@+id/vehicleNumberText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#D8DCE6"/><TextView android:id="@+id/licenseText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#D8DCE6"/><TextView android:id="@+id/dobText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#D8DCE6"/><TextView android:id="@+id/drivingLicenseNumberText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#D8DCE6"/><TextView android:id="@+id/aadhaarText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#D8DCE6"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardBackgroundColor="#151A22" app:strokeColor="#333E4655" app:strokeWidth="1dp" app:cardCornerRadius="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account activity" android:textColor="#FFF7FC" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/registeredText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#BFC5D1"/><TextView android:id="@+id/lastActiveText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#BFC5D1"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/editButton" style="@style/VJoyPremiumButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Edit Profile" android:visibility="gone"/><com.google.android.material.button.MaterialButton android:id="@+id/deleteAccountButton" style="@style/VJoyPremiumOutlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Delete Account" android:textColor="#FF8D9B"/><ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp"/><TextView android:id="@+id/messageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#BFC5D1"/><com.google.android.material.card.MaterialCardView android:id="@+id/stateCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" app:cardBackgroundColor="#151A22" app:strokeColor="#33464E60" app:strokeWidth="1dp" app:cardCornerRadius="22dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:id="@+id/stateTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF7FC" android:textStyle="bold"/><TextView android:id="@+id/stateMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#BFC5D1"/><com.google.android.material.button.MaterialButton android:id="@+id/retryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Retry"/></LinearLayout></com.google.android.material.card.MaterialCardView