<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NexamartPartner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nxm_primary</item>
        <item name="colorOnPrimary">@color/nxm_on_primary</item>
        <item name="colorSecondary">@color/nxm_secondary</item>
        <item name="colorOnSecondary">@color/nxm_on_secondary</item>
        <item name="colorSurface">@color/nxm_surface</item>
        <item name="colorOnSurface">@color/nxm_on_surface</item>
        <item name="colorSurfaceVariant">@color/nxm_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/nxm_on_surface_variant</item>
        <item name="colorError">@color/nxm_error</item>
        <item name="colorOnError">@color/nxm_on_error</item>
        <item name="android:statusBarColor">@color/nxm_background</item>
        <item name="android:navigationBarColor">@color/nxm_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/nxm_background</item>
    </style>
    <style name="VJoyPremiumCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#33464E60</item>
        <item name="cardBackgroundColor">@color/nxm_surface</item>
    </style>
    <style name="VJoyPremiumButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">28dp</item>
    </style>
    <style name="VJoyPremiumOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">27dp</item>
        <item name="strokeColor">#669DB8FF</item>
    </style>
    <style name="AdminPremiumCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#334F5D78</item>
        <item name="cardBackgroundColor">@color/nxm_surface</item>
    </style>
</resources>
